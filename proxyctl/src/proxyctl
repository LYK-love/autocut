#!/usr/bin/env bash
#
# proxyctl: manage an SSH SOCKS proxy and desktop/system proxy settings.

set -euo pipefail

APP_NAME="proxyctl"
PROG="$(basename "$0")"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/${APP_NAME}"
CONFIG_FILE="${CONFIG_DIR}/config"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/${APP_NAME}"
CONTROL_SOCKET="${STATE_DIR}/ssh-control.sock"
LOG_FILE="${STATE_DIR}/ssh.log"

DEFAULT_SOCKS_HOST="127.0.0.1"
DEFAULT_SOCKS_PORT="7899"
SSH_CONNECT_TIMEOUT="${PROXYCTL_SSH_CONNECT_TIMEOUT:-10}"

usage() {
  cat <<EOF
Usage:
  ${PROG} setup
  ${PROG} on
  ${PROG} off
  ${PROG} restart
  ${PROG} status
  ${PROG} env
  ${PROG} unenv
  ${PROG} help

Commands:
  setup     First-time setup. Saves SSH destination, SOCKS port, and system proxy backend.
  on        Start SSH tunnel, then enable the configured system proxy backend.
  off       Disable the configured system proxy backend, then stop SSH tunnel.
  restart   Turn proxy off and on again.
  status    Show config, SSH tunnel status, port status, and system proxy status.
  env       Print exports for terminal programs. Use with eval.
  unenv     Print unsets for terminal programs. Use with eval.
  help      Show this help message.

Typical first-time use:
  ${PROG} setup
  ${PROG} on

Terminal proxy use without editing shell startup files:
  eval "\$(${PROG} env)"

Stop proxy use in the current terminal:
  eval "\$(${PROG} unenv)"

Notes:
  - The SSH destination can be a ~/.ssh/config Host alias, user@host, domain name, or IP address.
  - macOS system proxy can be configured with networksetup, or skipped with backend "none".
  - Linux desktop proxy is currently supported for GNOME via gsettings.
  - Some terminal programs ignore proxy environment variables and need their own proxy config.
EOF
}

die() {
  printf '\nError: %s\n' "$*" >&2
  exit 1
}

info() {
  printf '%s\n' "$*"
}

ok() {
  printf 'OK: %s\n' "$*"
}

warn() {
  printf 'Warning: %s\n' "$*" >&2
}

section() {
  printf '\n== %s ==\n' "$*"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

detect_os() {
  if [[ -n "${PROXYCTL_TEST_OS:-}" ]]; then
    printf '%s\n' "$PROXYCTL_TEST_OS"
    return 0
  fi

  case "$(uname -s)" in
    Darwin) printf 'macos\n' ;;
    Linux) printf 'linux\n' ;;
    *) printf 'unsupported\n' ;;
  esac
}

ensure_supported_os() {
  case "$(detect_os)" in
    macos|linux) ;;
    *) die "unsupported operating system. Supported backends: macOS networksetup, Linux GNOME gsettings" ;;
  esac
}

ensure_dirs() {
  mkdir -p "$CONFIG_DIR" "$STATE_DIR"
  chmod 700 "$CONFIG_DIR" "$STATE_DIR"
}

shell_quote() {
  printf '%q' "$1"
}

load_config() {
  [[ -f "$CONFIG_FILE" ]] || die "no config found. Run: ${PROG} setup"
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"

  # Backward compatibility with early single-platform versions.
  SSH_DESTINATION="${SSH_DESTINATION:-${SSH_HOST:-}}"
  if [[ -z "${SYSTEM_BACKEND:-}" && -n "${NETWORK_SERVICE:-}" ]]; then
    SYSTEM_BACKEND="macos"
    SYSTEM_TARGET="$NETWORK_SERVICE"
  fi

  : "${SSH_DESTINATION:?missing SSH_DESTINATION in config}"
  : "${SOCKS_HOST:?missing SOCKS_HOST in config}"
  : "${SOCKS_PORT:?missing SOCKS_PORT in config}"
  : "${SYSTEM_BACKEND:?missing SYSTEM_BACKEND in config}"
  SYSTEM_TARGET="${SYSTEM_TARGET:-}"
}

write_config() {
  local ssh_destination="$1"
  local socks_host="$2"
  local socks_port="$3"
  local system_backend="$4"
  local system_target="$5"

  ensure_dirs
  {
    printf '# Generated by %s. Re-run "%s setup" to change it.\n' "$APP_NAME" "$PROG"
    printf 'SSH_DESTINATION=%s\n' "$(shell_quote "$ssh_destination")"
    printf 'SOCKS_HOST=%s\n' "$(shell_quote "$socks_host")"
    printf 'SOCKS_PORT=%s\n' "$(shell_quote "$socks_port")"
    printf 'SYSTEM_BACKEND=%s\n' "$(shell_quote "$system_backend")"
    printf 'SYSTEM_TARGET=%s\n' "$(shell_quote "$system_target")"
  } >"$CONFIG_FILE"
  chmod 600 "$CONFIG_FILE"
}

is_integer_port() {
  local value="$1"
  [[ "$value" =~ ^[0-9]+$ ]] && (( value >= 1 && value <= 65535 ))
}

list_macos_network_services() {
  networksetup -listallnetworkservices | sed '1{/asterisk/d;}'
}

guess_macos_network_service() {
  local service
  while IFS= read -r service; do
    [[ -z "$service" ]] && continue
    if networksetup -getinfo "$service" 2>/dev/null | grep -q '^IP address: [0-9]'; then
      printf '%s\n' "$service"
      return 0
    fi
  done < <(list_macos_network_services)

  if list_macos_network_services | grep -qx 'Wi-Fi'; then
    printf 'Wi-Fi\n'
    return 0
  fi

  list_macos_network_services | head -n 1
}

default_linux_backend() {
  if command -v gsettings >/dev/null 2>&1; then
    printf 'gnome\n'
  else
    printf 'none\n'
  fi
}

port_listener_summary() {
  local host="$1"
  local port="$2"

  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP@"$host":"$port" -sTCP:LISTEN 2>/dev/null || true
  fi
}

port_is_listening() {
  local host="$1"
  local port="$2"

  if [[ "${PROXYCTL_SKIP_PORT_CHECK:-0}" == "1" ]]; then
    return 1
  fi

  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP@"$host":"$port" -sTCP:LISTEN >/dev/null 2>&1
    return $?
  fi

  nc -z "$host" "$port" >/dev/null 2>&1
}

show_port_busy_help() {
  local host="$1"
  local port="$2"
  local listeners
  listeners="$(port_listener_summary "$host" "$port")"

  cat >&2 <<EOF

The local SOCKS port is already in use: ${host}:${port}

This usually means one of these is true:
  - proxyctl is already running but its SSH control socket was lost.
  - Another proxy program is using the same port.
  - An old SSH tunnel is still running.

EOF

  if [[ -n "$listeners" ]]; then
    printf 'Process currently listening on this port:\n' >&2
    printf '%s\n' "$listeners" | sed 's/^/  /' >&2
    printf '\n' >&2
  fi

  cat >&2 <<EOF
Fix options:
  1. Check current state:
       ${PROG} status

  2. Stop the old process, or choose another port:
       ${PROG} setup

  3. If you know the old tunnel belongs to proxyctl, try:
       ${PROG} off

EOF
}

check_port_available() {
  local host="$1"
  local port="$2"

  if port_is_listening "$host" "$port"; then
    show_port_busy_help "$host" "$port"
    exit 1
  fi
}

ssh_tunnel_alive() {
  if [[ "${PROXYCTL_TEST_TUNNEL_ALIVE:-0}" == "1" ]]; then
    return 0
  fi

  [[ -S "$CONTROL_SOCKET" ]] || return 1
  ssh -S "$CONTROL_SOCKET" -O check "$SSH_DESTINATION" >/dev/null 2>&1
}

print_ssh_failure_help() {
  local exit_code="$1"

  cat >&2 <<EOF

Could not start the SSH SOCKS tunnel.

What proxyctl tried:
  ssh -N -D ${SOCKS_HOST}:${SOCKS_PORT} ${SSH_DESTINATION}

Common causes:
  - The SSH destination "${SSH_DESTINATION}" is wrong or cannot be resolved.
  - If you used a short alias, it is not defined in ~/.ssh/config.
  - The server is offline or your network cannot reach it.
  - SSH authentication failed or needs an interactive password/passphrase.
  - The local port ${SOCKS_PORT} became occupied while starting.
  - The connection timed out after about ${SSH_CONNECT_TIMEOUT} seconds.

Try these commands manually:
  ssh ${SSH_DESTINATION}
  ssh -N -D ${SOCKS_HOST}:${SOCKS_PORT} ${SSH_DESTINATION}

SSH exit code: ${exit_code}
Log file: ${LOG_FILE}

Last log lines:
EOF
  if [[ -s "$LOG_FILE" ]]; then
    tail -n 20 "$LOG_FILE" | sed 's/^/  /' >&2
  else
    printf '  (SSH did not write any log output.)\n' >&2
  fi
}

start_ssh_tunnel() {
  require_command ssh
  ensure_dirs

  if ssh_tunnel_alive; then
    ok "SSH SOCKS tunnel is already running."
    return 0
  fi

  rm -f "$CONTROL_SOCKET"
  : >"$LOG_FILE"
  chmod 600 "$LOG_FILE"

  check_port_available "$SOCKS_HOST" "$SOCKS_PORT"

  section "Starting SSH tunnel"
  info "Local SOCKS:     ${SOCKS_HOST}:${SOCKS_PORT}"
  info "SSH destination: ${SSH_DESTINATION}"
  info "Log file:        ${LOG_FILE}"

  local ssh_exit_code
  ssh \
    -M \
    -S "$CONTROL_SOCKET" \
    -f \
    -N \
    -D "${SOCKS_HOST}:${SOCKS_PORT}" \
    -o ExitOnForwardFailure=yes \
    -o ConnectTimeout="$SSH_CONNECT_TIMEOUT" \
    -o ServerAliveInterval=60 \
    -o ServerAliveCountMax=3 \
    "$SSH_DESTINATION" \
    >>"$LOG_FILE" 2>&1 || {
      ssh_exit_code=$?
      print_ssh_failure_help "$ssh_exit_code"
      exit "$ssh_exit_code"
    }

  ssh_tunnel_alive || die "SSH returned success, but the control socket is not responding. Log file: ${LOG_FILE}"
  ok "SSH SOCKS tunnel is running."
}

stop_ssh_tunnel() {
  require_command ssh
  if [[ -S "$CONTROL_SOCKET" ]]; then
    info "Stopping SSH SOCKS tunnel."
    ssh -S "$CONTROL_SOCKET" -O exit "$SSH_DESTINATION" >/dev/null 2>&1 || true
    rm -f "$CONTROL_SOCKET"
  else
    info "SSH SOCKS tunnel is not running."
  fi
}

run_logged() {
  local description="$1"
  shift

  if "$@"; then
    return 0
  fi

  local exit_code=$?
  cat >&2 <<EOF

Could not ${description}.

Command failed:
  $*

Exit code: ${exit_code}
EOF
  exit "$exit_code"
}

enable_macos_proxy() {
  require_command networksetup
  [[ -n "$SYSTEM_TARGET" ]] || die "macOS backend requires SYSTEM_TARGET network service. Run: ${PROG} setup"

  section "Enabling macOS system proxy"
  info "Network service: ${SYSTEM_TARGET}"
  info "SOCKS proxy:     ${SOCKS_HOST}:${SOCKS_PORT}"
  run_logged "set the macOS SOCKS proxy server" \
    networksetup -setsocksfirewallproxy "$SYSTEM_TARGET" "$SOCKS_HOST" "$SOCKS_PORT"
  run_logged "enable the macOS SOCKS proxy" \
    networksetup -setsocksfirewallproxystate "$SYSTEM_TARGET" on
  ok "macOS SOCKS proxy is enabled."
}

disable_macos_proxy() {
  require_command networksetup
  [[ -n "$SYSTEM_TARGET" ]] || die "macOS backend requires SYSTEM_TARGET network service. Run: ${PROG} setup"

  section "Disabling macOS system proxy"
  info "Network service: ${SYSTEM_TARGET}"
  run_logged "disable the macOS SOCKS proxy" \
    networksetup -setsocksfirewallproxystate "$SYSTEM_TARGET" off
  ok "macOS SOCKS proxy is disabled."
}

status_macos_proxy() {
  require_command networksetup
  [[ -n "$SYSTEM_TARGET" ]] || die "macOS backend requires SYSTEM_TARGET network service. Run: ${PROG} setup"

  info "macOS SOCKS proxy:"
  local proxy_output proxy_enabled proxy_server proxy_port
  proxy_output="$(networksetup -getsocksfirewallproxy "$SYSTEM_TARGET" 2>&1)" || {
    printf '%s\n' "$proxy_output" | sed 's/^/  /'
    die "could not read macOS SOCKS proxy status for network service: ${SYSTEM_TARGET}"
  }
  printf '%s\n' "$proxy_output" | sed 's/^/  /'

  proxy_enabled="$(printf '%s\n' "$proxy_output" | awk -F': ' '/^Enabled:/ {print $2}')"
  proxy_server="$(printf '%s\n' "$proxy_output" | awk -F': ' '/^Server:/ {print $2}')"
  proxy_port="$(printf '%s\n' "$proxy_output" | awk -F': ' '/^Port:/ {print $2}')"

  info ""
  if [[ "$proxy_enabled" == "Yes" && "$proxy_server" == "$SOCKS_HOST" && "$proxy_port" == "$SOCKS_PORT" ]]; then
    ok "macOS system proxy points to proxyctl."
  elif [[ "$proxy_enabled" == "Yes" ]]; then
    info "Warning: macOS SOCKS proxy is enabled, but it points to ${proxy_server}:${proxy_port}, not ${SOCKS_HOST}:${SOCKS_PORT}."
  else
    info "macOS system proxy is off for this network service."
  fi
}

enable_gnome_proxy() {
  require_command gsettings
  section "Enabling GNOME system proxy"
  info "SOCKS proxy: ${SOCKS_HOST}:${SOCKS_PORT}"
  run_logged "set GNOME SOCKS host" gsettings set org.gnome.system.proxy.socks host "$SOCKS_HOST"
  run_logged "set GNOME SOCKS port" gsettings set org.gnome.system.proxy.socks port "$SOCKS_PORT"
  run_logged "enable GNOME manual proxy mode" gsettings set org.gnome.system.proxy mode manual
  ok "GNOME system proxy is enabled."
}

disable_gnome_proxy() {
  require_command gsettings
  section "Disabling GNOME system proxy"
  run_logged "disable GNOME system proxy" gsettings set org.gnome.system.proxy mode none
  ok "GNOME system proxy is disabled."
}

status_gnome_proxy() {
  require_command gsettings
  info "GNOME system proxy:"
  info "  mode: $(gsettings get org.gnome.system.proxy mode 2>/dev/null || printf 'unknown')"
  info "  socks host: $(gsettings get org.gnome.system.proxy.socks host 2>/dev/null || printf 'unknown')"
  info "  socks port: $(gsettings get org.gnome.system.proxy.socks port 2>/dev/null || printf 'unknown')"
}

enable_system_proxy() {
  case "$SYSTEM_BACKEND" in
    macos) enable_macos_proxy ;;
    gnome) enable_gnome_proxy ;;
    none)
      section "System proxy"
      info "No system proxy backend is configured."
      info "Terminal commands can still use: eval \"\$(${PROG} env)\""
      ;;
    *) die "unknown system proxy backend: ${SYSTEM_BACKEND}" ;;
  esac
}

disable_system_proxy() {
  case "$SYSTEM_BACKEND" in
    macos) disable_macos_proxy ;;
    gnome) disable_gnome_proxy ;;
    none) info "No system proxy backend is configured." ;;
    *) die "unknown system proxy backend: ${SYSTEM_BACKEND}" ;;
  esac
}

status_system_proxy() {
  case "$SYSTEM_BACKEND" in
    macos) status_macos_proxy ;;
    gnome) status_gnome_proxy ;;
    none) info "System proxy backend: none" ;;
    *) die "unknown system proxy backend: ${SYSTEM_BACKEND}" ;;
  esac
}

prompt_setup() {
  ensure_supported_os
  require_command ssh

  local os default_ssh_destination default_socks_host default_socks_port
  local default_backend default_target ssh_destination socks_host socks_port backend target
  os="$(detect_os)"
  default_ssh_destination=""
  default_socks_host="$DEFAULT_SOCKS_HOST"
  default_socks_port="$DEFAULT_SOCKS_PORT"
  default_backend="none"
  default_target=""

  if [[ "$os" == "macos" ]]; then
    require_command networksetup
    default_backend="macos"
    default_target="$(guess_macos_network_service)"
  elif [[ "$os" == "linux" ]]; then
    default_backend="$(default_linux_backend)"
  fi

  if [[ -f "$CONFIG_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
    default_ssh_destination="${SSH_DESTINATION:-${SSH_HOST:-}}"
    default_socks_host="${SOCKS_HOST:-$DEFAULT_SOCKS_HOST}"
    default_socks_port="${SOCKS_PORT:-$DEFAULT_SOCKS_PORT}"
    default_backend="${SYSTEM_BACKEND:-$default_backend}"
    default_target="${SYSTEM_TARGET:-${NETWORK_SERVICE:-$default_target}}"
    if [[ -z "${SYSTEM_BACKEND:-}" && -n "${NETWORK_SERVICE:-}" ]]; then
      default_backend="macos"
    fi
  fi

  cat <<EOF
proxyctl setup

This command saves the settings needed to turn the proxy on and off.
It will not edit ~/.zshrc, ~/.bashrc, or any other shell startup file.

You need three pieces of information:
  1. SSH destination: anything accepted by ssh, such as a Host alias, user@example.com, or an IP address.
  2. Local SOCKS address and port: usually ${DEFAULT_SOCKS_HOST}:${DEFAULT_SOCKS_PORT}.
  3. System proxy backend:
       - macOS: networksetup, with a network service name such as Wi-Fi.
       - Linux: GNOME gsettings, when available.
       - none: skip desktop/system proxy. Useful when Clash Verge manages system proxy.

EOF

  if [[ "$os" == "macos" ]]; then
    cat <<EOF
Available macOS network services on this Mac:
$(list_macos_network_services | sed 's/^/  - /')

You can list these yourself with:
  networksetup -listallnetworkservices

EOF
  elif [[ "$os" == "linux" ]]; then
    cat <<EOF
Linux backend detection:
  Suggested backend: ${default_backend}
  Supported Linux backend today: gnome

If your desktop environment is not GNOME, choose "none" and use:
  eval "\$(${PROG} env)"

EOF
  fi

  if [[ -n "$default_ssh_destination" ]]; then
    read -r -p "SSH destination [default: ${default_ssh_destination}; press Enter to keep it]: " ssh_destination
    ssh_destination="${ssh_destination:-$default_ssh_destination}"
  else
    read -r -p "SSH destination [required, no default; example: user@example.com]: " ssh_destination
  fi
  [[ -n "$ssh_destination" ]] || die "SSH destination is required. Example values: my-vps, user@example.com, 203.0.113.10"
  if ! ssh -G "$ssh_destination" >/dev/null 2>&1; then
    warn "SSH cannot fully parse '${ssh_destination}' right now."
    warn "You can still save it, but '${PROG} on' will fail unless ssh can resolve and connect to it."
  fi

  read -r -p "Local SOCKS bind address [default: ${default_socks_host}; press Enter to use it]: " socks_host
  socks_host="${socks_host:-$default_socks_host}"
  [[ -n "$socks_host" ]] || die "SOCKS bind address cannot be empty"

  read -r -p "Local SOCKS port [default: ${default_socks_port}; press Enter to use it]: " socks_port
  socks_port="${socks_port:-$default_socks_port}"
  is_integer_port "$socks_port" || die "SOCKS port must be an integer from 1 to 65535"
  if port_is_listening "$socks_host" "$socks_port"; then
    warn "Port ${socks_host}:${socks_port} is already in use."
    warn "That is okay only if you intentionally want to reuse this port after stopping the old process."
  fi

  if [[ "$os" == "macos" ]]; then
    read -r -p "macOS system proxy backend [default: ${default_backend}; options: macos, none]: " backend
    backend="${backend:-$default_backend}"
    case "$backend" in
      macos)
        read -r -p "macOS network service [default: ${default_target}; press Enter to use it]: " target
        target="${target:-$default_target}"
        [[ -n "$target" ]] || die "macOS network service cannot be empty"
        networksetup -getinfo "$target" >/dev/null 2>&1 || die "unknown macOS network service: $target. List valid names with: networksetup -listallnetworkservices"
        ;;
      none)
        target=""
        ;;
      *)
        die "unsupported macOS backend: ${backend}. Supported values: macos, none"
        ;;
    esac
  else
    read -r -p "Linux system proxy backend [default: ${default_backend}; options: gnome, none]: " backend
    backend="${backend:-$default_backend}"
    case "$backend" in
      gnome)
        command -v gsettings >/dev/null 2>&1 || die "GNOME backend requires gsettings. Choose backend 'none' or install gsettings."
        target=""
        ;;
      none)
        target=""
        ;;
      *)
        die "unsupported Linux backend: ${backend}. Supported values: gnome, none"
        ;;
    esac
  fi

  write_config "$ssh_destination" "$socks_host" "$socks_port" "$backend" "$target"

  section "Saved"
  info "Config file:      $CONFIG_FILE"
  info "SSH destination:  $ssh_destination"
  info "SOCKS endpoint:   ${socks_host}:${socks_port}"
  info "System backend:   $backend"
  [[ -n "$target" ]] && info "System target:    $target"

  section "Next steps"
  info "Turn proxy on:"
  info "  ${PROG} on"
  info ""
  info "Make terminal commands in this shell use the proxy:"
  info "  eval \"\$(${PROG} env)\""
}

cmd_on() {
  ensure_supported_os
  load_config
  start_ssh_tunnel
  enable_system_proxy

  cat <<EOF

Proxy is ON.

Current terminal:
  Run this if you also want proxy environment variables in this shell:
    eval "\$(${PROG} env)"
EOF
}

cmd_off() {
  ensure_supported_os
  load_config
  disable_system_proxy
  stop_ssh_tunnel

  cat <<EOF
Proxy is OFF for the configured system proxy backend.

If you previously ran eval "\$(${PROG} env)" in this terminal, unset it with:
  eval "\$(${PROG} unenv)"
EOF
}

cmd_status() {
  ensure_supported_os
  load_config

  info "Config:"
  info "  SSH destination:  ${SSH_DESTINATION}"
  info "  SOCKS endpoint:   ${SOCKS_HOST}:${SOCKS_PORT}"
  info "  System backend:   ${SYSTEM_BACKEND}"
  [[ -n "$SYSTEM_TARGET" ]] && info "  System target:    ${SYSTEM_TARGET}"
  info "  Config file:      ${CONFIG_FILE}"
  info ""

  if ssh_tunnel_alive; then
    info "SSH tunnel:         running"
  else
    info "SSH tunnel:         stopped"
  fi

  if port_is_listening "$SOCKS_HOST" "$SOCKS_PORT"; then
    info "Local port:         listening on ${SOCKS_HOST}:${SOCKS_PORT}"
    if ! ssh_tunnel_alive; then
      info "Warning:            port is listening, but proxyctl's SSH tunnel is not. Another process may be using the port."
    fi
  else
    info "Local port:         not listening on ${SOCKS_HOST}:${SOCKS_PORT}"
  fi

  info ""
  status_system_proxy
}

cmd_env() {
  load_config
  local proxy_url="socks5h://${SOCKS_HOST}:${SOCKS_PORT}"
  cat <<EOF
export ALL_PROXY=$(shell_quote "$proxy_url")
export all_proxy=$(shell_quote "$proxy_url")
export HTTPS_PROXY=$(shell_quote "$proxy_url")
export https_proxy=$(shell_quote "$proxy_url")
export HTTP_PROXY=$(shell_quote "$proxy_url")
export http_proxy=$(shell_quote "$proxy_url")
export NO_PROXY='localhost,127.0.0.1,::1'
export no_proxy='localhost,127.0.0.1,::1'
EOF
}

cmd_unenv() {
  cat <<'EOF'
unset ALL_PROXY
unset all_proxy
unset HTTPS_PROXY
unset https_proxy
unset HTTP_PROXY
unset http_proxy
unset NO_PROXY
unset no_proxy
EOF
}

main() {
  local command="${1:-help}"

  case "$command" in
    setup) prompt_setup ;;
    on|start) cmd_on ;;
    off|stop) cmd_off ;;
    restart) cmd_off; cmd_on ;;
    status) cmd_status ;;
    env) cmd_env ;;
    unenv) cmd_unenv ;;
    help|-h|--help) usage ;;
    *)
      usage >&2
      die "unknown command: $command"
      ;;
  esac
}

main "$@"
